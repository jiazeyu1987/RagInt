{
  "name": "voice-qa-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "voicekit-js": "file:vendor/voicekit-js-0.1.0.tgz"
  },
  "scripts": {
    "start": "set PORT=4981&& react-scripts start",
    "build": "react-scripts build",
    "build:ragint": "set BUILD_PATH=build-ragint&& set PUBLIC_URL=/ragint&& react-scripts build",
    "serve:dual:e2e": "node scripts/serve_dual_frontends.js",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:asr-accuracy": "node scripts/run_asr_accuracy_e2e.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "pw:install": "playwright install chromium",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
