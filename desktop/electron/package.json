{
  "name": "ragint-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop shell for RagInt",
  "author": "RagInt",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "pack:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "23.3.13",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.ragint.desktop",
    "productName": "RagInt Desktop",
    "electronDist": "node_modules/electron/dist",
    "artifactName": "RagInt-Desktop-${version}-Setup.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/backend/ragint-backend",
        "to": "backend"
      },
      {
        "from": "../dist/frontend/pad",
        "to": "frontend/pad"
      },
      {
        "from": "../dist/frontend/ragint",
        "to": "frontend/ragint"
      },
      {
        "from": "../dist/data-template",
        "to": "data-template"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "packElevateHelper": false,
      "warningsAsErrors": false
    }
  }
}
